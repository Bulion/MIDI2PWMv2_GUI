import { CheckBox } from "std-widgets.slint";
import { SliderWithPopup } from "../slider-with-popup.slint";
import { AppStyle } from "../style.slint";

export struct ToggleModeData {
    on_level: float,
    velocity_sensitive: bool,
    debounce_delay_ms: int,
}

export component ToggleModeParams inherits VerticalLayout {
    in-out property <ToggleModeData> data: {
        on_level: 100.0,
        velocity_sensitive: false,
        debounce_delay_ms: 50,
    };

    in property <int> confirmed_value: -1;
    in property <string> confirmed_field: "";

    in-out property <int> on_level_value: Math.round(root.data.on_level * 10.0);
    in-out property <int> debounce_value: root.data.debounce_delay_ms;

    private property <bool> ignore_on_level_changes: false;
    private property <bool> ignore_debounce_changes: false;

    private property <int> on_level_target: -1;
    private property <int> debounce_target: -1;

    callback changed();
    callback request_numeric_input(int, int, int, string, string, [float], string, int);

    changed confirmed_field => {
        if (root.confirmed_value >= 0) {
            if (root.confirmed_field == "toggle_on_level") {
                ignore_on_level_changes = true;
                on_level_target = root.confirmed_value;
                root.data.on_level = root.confirmed_value / 10.0;
                on_level_value = root.confirmed_value;
                root.changed();
            } else if (root.confirmed_field == "toggle_debounce") {
                ignore_debounce_changes = true;
                debounce_target = root.confirmed_value;
                root.data.debounce_delay_ms = root.confirmed_value;
                debounce_value = root.confirmed_value;
                root.changed();
            }
        }
    }

    spacing: AppStyle.spacing_sm;

    SliderWithPopup {
        label: "On Level";
        minimum: 0;
        maximum: 100.0;
        value <=> root.on_level_value;
        suffix: "%";
        max_decimals: 1;
        quick_buttons: [0, 50.0, 100.0];
        field_name: "toggle_on_level";
        request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals) => {
            ignore_on_level_changes = false;
            root.request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals);
        }
        changed(new_value) => {
            if (root.ignore_on_level_changes) {
                if (Math.abs(new_value - root.on_level_target) < 5) {
                    ignore_on_level_changes = false;
                    on_level_target = -1;
                }
            } else {
                root.data.on_level = new_value / 10.0;
                root.changed();
            }
        }
    }

    CheckBox {
        text: "Velocity Sensitive";
        checked: root.data.velocity_sensitive;
        toggled => {
            root.data.velocity_sensitive = self.checked;
            root.changed();
        }
    }

    SliderWithPopup {
        label: "Debounce";
        minimum: 0;
        maximum: 500;
        value <=> root.debounce_value;
        suffix: "ms";
        quick_buttons: [0, 50, 100];
        field_name: "toggle_debounce";
        request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals) => {
            ignore_debounce_changes = false;
            root.request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals);
        }
        changed(new_value) => {
            if (root.ignore_debounce_changes) {
                if (Math.abs(new_value - root.debounce_target) < 5) {
                    ignore_debounce_changes = false;
                    debounce_target = -1;
                }
            } else {
                root.data.debounce_delay_ms = new_value;
                root.changed();
            }
        }
    }
}
