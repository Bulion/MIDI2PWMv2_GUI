import { CheckBox } from "std-widgets.slint";
import { SliderWithPopup } from "../slider-with-popup.slint";

export struct RampedModeData {
    on_level: int,
    velocity_sensitive: bool,
    attack_time_ms: int,
    release_time_ms: int,
}

export component RampedModeParams inherits VerticalLayout {
    in-out property <RampedModeData> data: {
        on_level: 255,
        velocity_sensitive: true,
        attack_time_ms: 100,
        release_time_ms: 100,
    };

    in property <int> confirmed_value: -1;
    in property <string> confirmed_field: "";

    in-out property <int> on_level_value: Math.round((root.data.on_level / 255.0) * 1000.0);
    in-out property <int> attack_time_value: root.data.attack_time_ms;
    in-out property <int> release_time_value: root.data.release_time_ms;

    private property <bool> ignore_on_level_changes: false;
    private property <bool> ignore_attack_changes: false;
    private property <bool> ignore_release_changes: false;

    private property <int> on_level_target: -1;
    private property <int> attack_target: -1;
    private property <int> release_target: -1;

    callback changed();
    callback request_numeric_input(int, int, int, string, string, [string], string, bool);

    changed confirmed_field => {
        if (root.confirmed_value >= 0) {
            if (root.confirmed_field == "ramped_on_level") {
                ignore_on_level_changes = true;
                on_level_target = root.confirmed_value;
                root.data.on_level = Math.round((root.confirmed_value / 1000.0) * 255.0);
                on_level_value = root.confirmed_value;
                root.changed();
            } else if (root.confirmed_field == "ramped_attack") {
                ignore_attack_changes = true;
                attack_target = root.confirmed_value;
                root.data.attack_time_ms = root.confirmed_value;
                attack_time_value = root.confirmed_value;
                root.changed();
            } else if (root.confirmed_field == "ramped_release") {
                ignore_release_changes = true;
                release_target = root.confirmed_value;
                root.data.release_time_ms = root.confirmed_value;
                release_time_value = root.confirmed_value;
                root.changed();
            }
        }
    }

    spacing: 6px;

    SliderWithPopup {
        label: "On Level";
        minimum: 0;
        maximum: 1000;
        value <=> root.on_level_value;
        suffix: "%";
        is_float: true;
        quick_buttons: ["0", "500", "1000"];
        field_name: "ramped_on_level";
        request_numeric_input(min, max, val, label, suffix, buttons, field, is_float) => {
            ignore_on_level_changes = false;
            root.request_numeric_input(min, max, val, label, suffix, buttons, field, is_float);
        }
        changed(new_value) => {
            if (root.ignore_on_level_changes) {
                if (Math.abs(new_value - root.on_level_target) < 5) {
                    ignore_on_level_changes = false;
                    on_level_target = -1;
                }
            } else {
                root.data.on_level = Math.round((new_value / 1000.0) * 255.0);
                root.changed();
            }
        }
    }

    CheckBox {
        text: "Velocity Sensitive";
        checked: root.data.velocity_sensitive;
        toggled => {
            root.data.velocity_sensitive = self.checked;
            root.changed();
        }
    }

    SliderWithPopup {
        label: "Attack";
        minimum: 0;
        maximum: 1000;
        value <=> root.attack_time_value;
        suffix: "ms";
        quick_buttons: ["0", "500", "1000"];
        field_name: "ramped_attack";
        request_numeric_input(min, max, val, label, suffix, buttons, field, is_float) => {
            ignore_attack_changes = false;
            root.request_numeric_input(min, max, val, label, suffix, buttons, field, is_float);
        }
        changed(new_value) => {
            if (root.ignore_attack_changes) {
                if (Math.abs(new_value - root.attack_target) < 5) {
                    ignore_attack_changes = false;
                    attack_target = -1;
                }
            } else {
                root.data.attack_time_ms = new_value;
                root.changed();
            }
        }
    }

    SliderWithPopup {
        label: "Release";
        minimum: 0;
        maximum: 1000;
        value <=> root.release_time_value;
        suffix: "ms";
        quick_buttons: ["0", "500", "1000"];
        field_name: "ramped_release";
        request_numeric_input(min, max, val, label, suffix, buttons, field, is_float) => {
            ignore_release_changes = false;
            root.request_numeric_input(min, max, val, label, suffix, buttons, field, is_float);
        }
        changed(new_value) => {
            if (root.ignore_release_changes) {
                if (Math.abs(new_value - root.release_target) < 5) {
                    ignore_release_changes = false;
                    release_target = -1;
                }
            } else {
                root.data.release_time_ms = new_value;
                root.changed();
            }
        }
    }
}
