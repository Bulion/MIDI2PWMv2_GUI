import { Button } from "std-widgets.slint";
import { AppStyle } from "style.slint";

export component ConfirmDialog inherits Rectangle {
    callback save_and_close;
    callback discard_and_close;
    callback cancel;

    width: AppStyle.popup_confirm_width;
    height: AppStyle.popup_confirm_height;
    background: AppStyle.bg_popup;
    border-radius: AppStyle.radius_md;
    border-width: AppStyle.border_width_normal;
    border-color: AppStyle.accent_orange;

    VerticalLayout {
        padding: AppStyle.spacing_xxl;
        spacing: AppStyle.spacing_xl;

        Text {
            text: "Unsaved Changes";
            font-size: AppStyle.font_size_subheading;
            color: AppStyle.text_primary;
            horizontal-alignment: center;
        }

        Text {
            text: "You have unsaved changes. What would you like to do?";
            font-size: AppStyle.font_size_body;
            color: AppStyle.text_tertiary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: AppStyle.spacing_md;
            padding-top: AppStyle.spacing_md;

            Button {
                text: "Save";
                clicked => {
                    root.save_and_close();
                }
            }

            Button {
                text: "Discard";
                clicked => {
                    root.discard_and_close();
                }
            }

            Button {
                text: "Cancel";
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}
