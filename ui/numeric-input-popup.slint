import { Button } from "std-widgets.slint";
import { AppStyle } from "style.slint";
import { CalculatorButton } from "components/calculator_button.slint";

export component NumericInputPopup inherits Rectangle {
    in property <int> min_value: 0;
    in property <int> max_value: 255;
    in property <int> current_value: 0;
    in property <string> label: "Value";
    in property <string> suffix: "";
    in property <[string]> quick_buttons: [];
    in property <int> max_decimals: 0;

    callback confirmed(int);
    callback canceled();

    private property <int> integer_part: 0;
    private property <int> decimal_part: 0;
    private property <int> decimal_digits_entered: 0;
    private property <bool> has_decimal_point: false;
    private property <bool> first_digit_entry: true;
    private property <string> input_text: "";
    private property <float> display_scale: max_decimals > 0 ? Math.pow(10.0, max_decimals) : 1.0;
    private property <int> parsed_value: root.compute_scaled_value();
    private property <bool> is_valid:
        parsed_value >= min_value &&
        parsed_value <= max_value;

    function update_display() {
        if (root.first_digit_entry && root.integer_part == 0 && root.decimal_part == 0 && root.decimal_digits_entered == 0 && !root.has_decimal_point) {
            root.input_text = "";
        } else if (root.has_decimal_point) {
            if (root.decimal_digits_entered == 0) {
                root.input_text = root.integer_part + ".";
            } else {
                root.input_text = root.integer_part + "." + root.format_decimal_part();
            }
        } else {
            root.input_text = root.integer_part + "";
        }
    }

    function format_decimal_part() -> string {
        if (root.max_decimals == 1) {
            return root.decimal_part + "";
        } else if (root.max_decimals == 2) {
            if (root.decimal_digits_entered == 1) {
                return root.decimal_part + "";
            } else if (root.decimal_part < 10) {
                return "0" + root.decimal_part;
            } else {
                return root.decimal_part + "";
            }
        }
        return root.decimal_part + "";
    }

    pure function compute_scaled_value() -> int {
        if (max_decimals > 0) {
            return integer_part * Math.round(display_scale) + decimal_part * Math.round(display_scale / Math.pow(10.0, decimal_digits_entered));
        }
        return integer_part;
    }

    pure function would_digit_exceed_max(digit: int) -> bool {
        if (has_decimal_point) {
            if (decimal_digits_entered >= max_decimals) {
                return true;
            }
            return integer_part * Math.round(display_scale) +
                   (decimal_part * 10 + digit) * Math.round(display_scale / Math.pow(10.0, decimal_digits_entered + 1)) > max_value;
        } else {
            if (max_decimals > 0) {
                return (integer_part * 10 + digit) * Math.round(display_scale) > max_value;
            } else {
                return integer_part * 10 + digit > max_value;
            }
        }
    }

    function handle_digit_input(digit_value: int) {
        if (root.first_digit_entry) {
            // First digit replaces everything - validate only the new digit
            if (max_decimals > 0) {
                if (digit_value * Math.round(display_scale) > max_value) {
                    return;
                }
            } else {
                if (digit_value > max_value) {
                    return;
                }
            }
            root.integer_part = digit_value;
            root.decimal_part = 0;
            root.decimal_digits_entered = 0;
            root.has_decimal_point = false;
            first_digit_entry = false;
        } else {
            // Appending to existing value - validate full value
            if (root.would_digit_exceed_max(digit_value)) {
                return;
            }
            if (root.has_decimal_point) {
                root.decimal_part = root.decimal_part * 10 + digit_value;
                root.decimal_digits_entered = root.decimal_digits_entered + 1;
            } else {
                root.integer_part = root.integer_part * 10 + digit_value;
            }
        }
        root.update_display();
    }

    function handle_decimal_point() {
        if (root.max_decimals > 0) {
            if (root.first_digit_entry) {
                // First input is decimal point - start with "0."
                root.integer_part = 0;
                root.decimal_part = 0;
                root.decimal_digits_entered = 0;
                root.has_decimal_point = true;
                first_digit_entry = false;
                root.update_display();
            } else if (!root.has_decimal_point) {
                // Add decimal point to existing integer
                root.has_decimal_point = true;
                root.update_display();
            }
        }
    }

    function handle_backspace() {
        if (root.decimal_digits_entered > 0) {
            root.decimal_part = Math.floor(root.decimal_part / 10);
            root.decimal_digits_entered = root.decimal_digits_entered - 1;
        } else if (root.has_decimal_point) {
            root.has_decimal_point = false;
        } else if (root.integer_part > 0) {
            root.integer_part = Math.floor(root.integer_part / 10);
            if (root.integer_part == 0) {
                first_digit_entry = true;
            }
        }
        root.update_display();
    }

    changed current_value => {
        if (max_decimals > 0) {
            root.integer_part = Math.floor(current_value / Math.round(display_scale));
            root.decimal_part = Math.mod(current_value, Math.round(display_scale));
            root.decimal_digits_entered = max_decimals;
            root.has_decimal_point = true;
        } else {
            root.integer_part = current_value;
            root.decimal_part = 0;
            root.decimal_digits_entered = 0;
            root.has_decimal_point = false;
        }
        first_digit_entry = true;
        root.update_display();
    }

    width: AppStyle.popup_numeric_width;
    height: AppStyle.popup_numeric_height;
    background: AppStyle.bg_popup;
    border-radius: AppStyle.radius_md;
    border-width: AppStyle.border_width_normal;
    border-color: AppStyle.accent_orange;

    TouchArea {
        width: parent.width;
        height: parent.height;
    }

    VerticalLayout {
        padding: AppStyle.spacing_xl;
        spacing: AppStyle.spacing_lg;

        HorizontalLayout {
            Text {
                text: root.label + (root.suffix != "" ? " (" + root.suffix + ")" : "");
                font-size: AppStyle.font_size_body_lg;
                color: AppStyle.text_primary;
                font-weight: 600;
                vertical-alignment: center;
            }

            Button {
                text: "X";
                width: AppStyle.input_height_sm;
                height: AppStyle.input_height_sm;
                clicked => {
                    root.canceled();
                }
            }
        }

        Rectangle {
            height: AppStyle.input_height_lg;
            background: AppStyle.bg_primary;
            border-width: AppStyle.border_width_thin;
            border-color: AppStyle.border_default;

            Text {
                text: root.input_text;
                font-size: AppStyle.font_size_heading;
                color: root.is_valid ? AppStyle.text_primary : AppStyle.status_error;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            background: AppStyle.bg_popup;

            VerticalLayout {
                spacing: AppStyle.spacing_md;

                GridLayout {
                    spacing: AppStyle.spacing_sm;

                    Row {
                        CalculatorButton {
                            text: "7";
                            clicked => { root.handle_digit_input(7); }
                        }
                        CalculatorButton {
                            text: "8";
                            clicked => { root.handle_digit_input(8); }
                        }
                        CalculatorButton {
                            text: "9";
                            clicked => { root.handle_digit_input(9); }
                        }
                        CalculatorButton {
                            text: "←";
                            button_background: AppStyle.bg_button;
                            clicked => { root.handle_backspace(); }
                        }
                    }

                    Row {
                        CalculatorButton {
                            text: "4";
                            clicked => { root.handle_digit_input(4); }
                        }
                        CalculatorButton {
                            text: "5";
                            clicked => { root.handle_digit_input(5); }
                        }
                        CalculatorButton {
                            text: "6";
                            clicked => { root.handle_digit_input(6); }
                        }
                    }

                    Row {
                        CalculatorButton {
                            text: "1";
                            clicked => { root.handle_digit_input(1); }
                        }
                        CalculatorButton {
                            text: "2";
                            clicked => { root.handle_digit_input(2); }
                        }
                        CalculatorButton {
                            text: "3";
                            clicked => { root.handle_digit_input(3); }
                        }
                    }

                    Row {
                        CalculatorButton {
                            text: "0";
                            clicked => { root.handle_digit_input(0); }
                        }

                        CalculatorButton {
                            visible: root.max_decimals > 0;
                            text: ".";
                            clicked => {
                                root.handle_decimal_point();
                            }
                        }

                        CalculatorButton {
                            text: "C";
                            text_color: AppStyle.status_error;
                            button_background: AppStyle.bg_button;
                            clicked => {
                                root.integer_part = 0;
                                root.decimal_part = 0;
                                root.decimal_digits_entered = 0;
                                root.has_decimal_point = false;
                                first_digit_entry = true;
                                root.update_display();
                            }
                        }
                    }
                }

                if root.quick_buttons.length > 0: HorizontalLayout {
                    spacing: AppStyle.spacing_sm;

                    for button-value-str[index] in root.quick_buttons: Rectangle {
                        property <int> button-value: button-value-str.to-float();

                        background: AppStyle.accent_orange;
                        border-width: AppStyle.border_width_thin;
                        border-color: AppStyle.accent_orange_dark;

                        Text {
                            text: root.max_decimals > 0 ?
                                (Math.floor(button-value / Math.round(root.display_scale)) + "." + Math.mod(button-value, Math.round(root.display_scale))) :
                                button-value + "";
                            font-size: AppStyle.font_size_body;
                            color: AppStyle.text_primary;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => {
                                if (root.max_decimals > 0) {
                                    root.integer_part = Math.floor(button-value / Math.round(root.display_scale));
                                    root.decimal_part = Math.mod(button-value, Math.round(root.display_scale));
                                    root.decimal_digits_entered = root.max_decimals;
                                    root.has_decimal_point = true;
                                } else {
                                    root.integer_part = button-value;
                                    root.decimal_part = 0;
                                    root.decimal_digits_entered = 0;
                                    root.has_decimal_point = false;
                                }
                                first_digit_entry = false;
                                root.update_display();
                            }
                        }
                    }
                }

                Rectangle {
                    height: AppStyle.input_height;
                    background: root.is_valid ? AppStyle.accent_green_confirm : AppStyle.border_default;
                    border-width: AppStyle.border_width_thin;
                    border-color: root.is_valid ? AppStyle.accent_green_confirm_hover : AppStyle.border_default;

                    Text {
                        text: "Confirm";
                        font-size: AppStyle.font_size_body_lg;
                        color: root.is_valid ? AppStyle.text_primary : AppStyle.text_disabled;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        enabled: root.is_valid;
                        clicked => {
                            if (root.is_valid) {
                                root.confirmed(root.parsed_value);
                            }
                        }
                    }
                }
            }
        }
    }
}
