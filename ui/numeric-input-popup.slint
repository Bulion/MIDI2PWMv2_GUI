import { Button } from "std-widgets.slint";
import { AppStyle } from "style.slint";
import { CalculatorButton } from "components/calculator_button.slint";

export component NumericInputPopup inherits Rectangle {
    in property <int> min_value: 0;
    in property <int> max_value: 255;
    in property <int> current_value: 0;
    in property <string> label: "Value";
    in property <string> suffix: "";
    in property <[string]> quick_buttons: [];
    in property <int> max_decimals: 0;

    callback confirmed(int);
    callback canceled();

    private property <string> input_text: "";
    private property <bool> first_digit_entry: true;
    private property <float> display_scale: max_decimals > 0 ? Math.pow(10.0, max_decimals) : 1.0;
    private property <float> parsed_float: input_text.to-float();
    private property <int> parsed_value: max_decimals > 0 ? Math.round(parsed_float * display_scale) : Math.round(parsed_float);
    private property <bool> is_valid: parsed_value >= min_value && parsed_value <= max_value && root.is_input_valid();
    private property <int> decimal_count: root.count_decimals(input_text);

    pure function count_decimals(text: string) -> int {
        if (text.is-float()) {
            return 0;
        }
        return 0;
    }

    pure function is_input_valid() -> bool {
        if (input_text == "" || input_text == "." || input_text == "-") {
            return false;
        }
        if (!input_text.is-float()) {
            return false;
        }
        return true;
    }

    pure function can_append(char: string) -> bool {
        if (first_digit_entry) {
            return true;
        }

        if (char == ".") {
            return max_decimals > 0;
        }

        if (input_text == "" || input_text == "0") {
            return true;
        }

        if (!input_text.is-float()) {
            return true;
        }

        return true;
    }

    pure function would_exceed_max(new_text: string) -> bool {
        if (!new_text.is-float()) {
            return false;
        }

        if (max_decimals > 0) {
            return Math.round(new_text.to-float() * display_scale) > max_value;
        } else {
            return Math.round(new_text.to-float()) > max_value;
        }
    }

    changed current_value => {
        if (max_decimals > 0) {
            root.input_text = (current_value / display_scale);
        } else {
            root.input_text = current_value + "";
        }
        first_digit_entry = true;
    }

    width: AppStyle.popup_numeric_width;
    height: AppStyle.popup_numeric_height;
    background: AppStyle.bg_popup;
    border-radius: AppStyle.radius_md;
    border-width: AppStyle.border_width_normal;
    border-color: AppStyle.accent_orange;

    TouchArea {
        width: parent.width;
        height: parent.height;
    }

    VerticalLayout {
        padding: AppStyle.spacing_xl;
        spacing: AppStyle.spacing_lg;

        HorizontalLayout {
            Text {
                text: root.label + (root.suffix != "" ? " (" + root.suffix + ")" : "");
                font-size: AppStyle.font_size_body_lg;
                color: AppStyle.text_primary;
                font-weight: 600;
                vertical-alignment: center;
            }

            Button {
                text: "X";
                width: AppStyle.input_height_sm;
                height: AppStyle.input_height_sm;
                clicked => {
                    root.canceled();
                }
            }
        }

        Rectangle {
            height: AppStyle.input_height_lg;
            background: AppStyle.bg_primary;
            border-width: AppStyle.border_width_thin;
            border-color: AppStyle.border_default;

            Text {
                text: root.input_text;
                font-size: AppStyle.font_size_heading;
                color: root.is_valid ? AppStyle.text_primary : AppStyle.status_error;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            background: AppStyle.bg_popup;

            VerticalLayout {
                spacing: AppStyle.spacing_md;

                GridLayout {
                    spacing: AppStyle.spacing_sm;
                    Row {
                        CalculatorButton {
                            text: "7";
                            clicked => {
                                if (root.first_digit_entry) {
                                    if (!root.would_exceed_max("7")) {
                                        root.input_text = "7";
                                        first_digit_entry = false;
                                    }
                                } else {
                                    if (!root.would_exceed_max(root.input_text + "7")) {
                                        root.input_text += "7";
                                    }
                                }
                            }
                        }

                        CalculatorButton {
                            text: "8";
                            clicked => {
                                if (root.first_digit_entry) {
                                    if (!root.would_exceed_max("8")) {
                                        root.input_text = "8";
                                        first_digit_entry = false;
                                    }
                                } else {
                                    if (!root.would_exceed_max(root.input_text + "8")) {
                                        root.input_text += "8";
                                    }
                                }
                            }
                        }

                        CalculatorButton {
                            text: "9";
                            clicked => {
                                if (root.first_digit_entry) {
                                    if (!root.would_exceed_max("9")) {
                                        root.input_text = "9";
                                        first_digit_entry = false;
                                    }
                                } else {
                                    if (!root.would_exceed_max(root.input_text + "9")) {
                                        root.input_text += "9";
                                    }
                                }
                            }
                        }

                        CalculatorButton {
                            col: 3;
                            colspan: 1;
                            text: "←";
                            button_background: AppStyle.bg_button;
                            clicked => {
                                root.input_text = "";
                            }
                        }
                    }

                    Row {
                        CalculatorButton {
                            text: "4";
                            clicked => {
                                if (root.first_digit_entry) {
                                    if (!root.would_exceed_max("4")) {
                                        root.input_text = "4";
                                        first_digit_entry = false;
                                    }
                                } else {
                                    if (!root.would_exceed_max(root.input_text + "4")) {
                                        root.input_text += "4";
                                    }
                                }
                            }
                        }

                        CalculatorButton {
                            text: "5";
                            clicked => {
                                if (root.first_digit_entry) {
                                    if (!root.would_exceed_max("5")) {
                                        root.input_text = "5";
                                        first_digit_entry = false;
                                    }
                                } else {
                                    if (!root.would_exceed_max(root.input_text + "5")) {
                                        root.input_text += "5";
                                    }
                                }
                            }
                        }

                        CalculatorButton {
                            text: "6";
                            clicked => {
                                if (root.first_digit_entry) {
                                    if (!root.would_exceed_max("6")) {
                                        root.input_text = "6";
                                        first_digit_entry = false;
                                    }
                                } else {
                                    if (!root.would_exceed_max(root.input_text + "6")) {
                                        root.input_text += "6";
                                    }
                                }
                            }
                        }
                    }

                    Row {
                        CalculatorButton {
                            text: "1";
                            clicked => {
                                if (root.first_digit_entry) {
                                    if (!root.would_exceed_max("1")) {
                                        root.input_text = "1";
                                        first_digit_entry = false;
                                    }
                                } else {
                                    if (!root.would_exceed_max(root.input_text + "1")) {
                                        root.input_text += "1";
                                    }
                                }
                            }
                        }

                        CalculatorButton {
                            text: "2";
                            clicked => {
                                if (root.first_digit_entry) {
                                    if (!root.would_exceed_max("2")) {
                                        root.input_text = "2";
                                        first_digit_entry = false;
                                    }
                                } else {
                                    if (!root.would_exceed_max(root.input_text + "2")) {
                                        root.input_text += "2";
                                    }
                                }
                            }
                        }

                        CalculatorButton {
                            text: "3";
                            clicked => {
                                if (root.first_digit_entry) {
                                    if (!root.would_exceed_max("3")) {
                                        root.input_text = "3";
                                        first_digit_entry = false;
                                    }
                                } else {
                                    if (!root.would_exceed_max(root.input_text + "3")) {
                                        root.input_text += "3";
                                    }
                                }
                            }
                        }
                    }

                    Row {
                        CalculatorButton {
                            text: "0";
                            clicked => {
                                if (root.first_digit_entry) {
                                    if (!root.would_exceed_max("0")) {
                                        root.input_text = "0";
                                        first_digit_entry = false;
                                    }
                                } else {
                                    if (!root.would_exceed_max(root.input_text + "0")) {
                                        root.input_text += "0";
                                    }
                                }
                            }
                        }

                        CalculatorButton {
                            visible: root.max_decimals > 0;
                            text: ".";
                            clicked => {
                                if (root.first_digit_entry) {
                                    root.input_text = "0.";
                                    first_digit_entry = false;
                                } else {
                                    root.input_text += ".";
                                }
                            }
                        }

                        CalculatorButton {
                            col: 2;
                            text: "C";
                            text_color: AppStyle.status_error;
                            button_background: AppStyle.bg_button;
                            clicked => {
                                root.input_text = "";
                            }
                        }
                    }
                }

                if root.quick_buttons.length > 0: HorizontalLayout {
                    spacing: AppStyle.spacing_sm;

                    for button-text[index] in root.quick_buttons: Rectangle {
                        background: AppStyle.accent_orange;
                        border-width: AppStyle.border_width_thin;
                        border-color: AppStyle.accent_orange_dark;

                        Text {
                            text: root.max_decimals > 0 ? (button-text.to-float() / root.display_scale) : button-text;
                            font-size: AppStyle.font_size_body;
                            color: AppStyle.text_primary;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => {
                                root.input_text = root.max_decimals > 0 ? (button-text.to-float() / root.display_scale) : button-text;
                                first_digit_entry = false;
                            }
                        }
                    }
                }

                Rectangle {
                    height: AppStyle.input_height;
                    background: root.is_valid ? AppStyle.accent_green_confirm : AppStyle.border_default;
                    border-width: AppStyle.border_width_thin;
                    border-color: root.is_valid ? AppStyle.accent_green_confirm_hover : AppStyle.border_default;

                    Text {
                        text: "Confirm";
                        font-size: AppStyle.font_size_body_lg;
                        color: root.is_valid ? AppStyle.text_primary : AppStyle.text_disabled;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        enabled: root.is_valid;
                        clicked => {
                            if (root.is_valid) {
                                root.confirmed(root.parsed_value);
                            }
                        }
                    }
                }
            }
        }
    }
}
