import { ComboBox } from "std-widgets.slint";
import { InstantModeParams, InstantModeData } from "mode-params/instant-mode-params.slint";
import { RampedModeParams, RampedModeData } from "mode-params/ramped-mode-params.slint";
import { PulseModeParams, PulseModeData } from "mode-params/pulse-mode-params.slint";
import { ToggleModeParams, ToggleModeData } from "mode-params/toggle-mode-params.slint";
import { ADSRModeParams, ADSRModeData } from "mode-params/adsr-mode-params.slint";
import { CCControlModeParams, CCControlModeData } from "mode-params/cc-control-mode-params.slint";
import { PitchBendModeParams, PitchBendModeData } from "mode-params/pitchbend-mode-params.slint";
import { AppStyle } from "style.slint";

export struct ModeConfig {
    mode_type: int,
    polarity: int,
    release_action: int,
    configuration: int,
    note_b: string,
    instant_data: InstantModeData,
    ramped_data: RampedModeData,
    pulse_data: PulseModeData,
    toggle_data: ToggleModeData,
    adsr_data: ADSRModeData,
    cc_data: CCControlModeData,
    pitchbend_data: PitchBendModeData,
}

export component ModeSelectionSection inherits VerticalLayout {
    in-out property <ModeConfig> mode_config: {
        mode_type: 0,
        polarity: 0,
        release_action: 0,
        configuration: 0,
        note_b: "",
        instant_data: { on_level: 100.0, velocity_sensitive: true },
        ramped_data: { on_level: 100.0, velocity_sensitive: true, attack_time_ms: 100, release_time_ms: 100 },
        pulse_data: { on_level: 100.0, velocity_sensitive: true, attack_time_ms: 10, hold_time_ms: 100, release_time_ms: 50 },
        toggle_data: { on_level: 100.0, velocity_sensitive: false, debounce_delay_ms: 50 },
        adsr_data: { attack_level: 100.0, sustain_level: 78.4, velocity_sensitive: true, attack_time_ms: 50, decay_time_ms: 100, release_time_ms: 200 },
        cc_data: { cc_number: 1, center_value: 64, left_max_pwm: 100.0, right_max_pwm: 100.0, deadband_range: 2 },
        pitchbend_data: { base_level: 50.2, bend_range: 25.1, unipolar: false, velocity_sensitive: true },
    };

    private property <bool> is_half_bridge: root.mode_config.configuration == 1;

    in property <float> confirmed_value: -1;
    in property <string> confirmed_field: "";

    in-out property <bool> is_assigning_cc: false;

    callback mode_changed;
    callback request_numeric_input(float, float, float, string, string, [float], string, int);
    callback assign_cc;
    callback reset_cc;

    alignment: LayoutAlignment.start;
    spacing: AppStyle.spacing_md;

    if !root.is_half_bridge: Text {
        text: "Output Mode";
        font-size: AppStyle.font_size_body;
        color: AppStyle.text_primary;
        font-weight: 600;
        height: 24px;
    }

    if !root.is_half_bridge: ComboBox {
        height: 30px;
        model: ["Instant On/Off", "Ramped On/Off", "Timed Pulse", "Toggle", "ADSR Envelope", "CC Control", "Pitch Bend"];
        current-index: root.mode_config.mode_type;
        selected(selected-value) => {
            if (selected-value == "Instant On/Off") {
                root.mode_config.mode_type = 0;
            } else if (selected-value == "Ramped On/Off") {
                root.mode_config.mode_type = 1;
            } else if (selected-value == "Timed Pulse") {
                root.mode_config.mode_type = 2;
            } else if (selected-value == "Toggle") {
                root.mode_config.mode_type = 3;
            } else if (selected-value == "ADSR Envelope") {
                root.mode_config.mode_type = 4;
            } else if (selected-value == "CC Control") {
                root.mode_config.mode_type = 5;
            } else if (selected-value == "Pitch Bend") {
                root.mode_config.mode_type = 6;
            }
            root.mode_changed();
        }
    }

    if !root.is_half_bridge: HorizontalLayout {
        spacing: AppStyle.spacing_xs;
        height: 54px;

        VerticalLayout {
            spacing: AppStyle.spacing_xs;
            Text {
                text: "Direction";
                font-size: AppStyle.font_size_small;
                color: AppStyle.text_secondary;
                height: 18px;
            }
            ComboBox {
                height: 30px;
                min-width: 0px;
                model: ["Forward", "Reverse"];
                current-index: root.mode_config.polarity;
                selected(val) => {
                    if (val == "Forward") {
                        root.mode_config.polarity = 0;
                    } else {
                        root.mode_config.polarity = 1;
                    }
                    root.mode_changed();
                }
            }
        }

        VerticalLayout {
            spacing: AppStyle.spacing_xs;
            Text {
                text: "Release";
                font-size: AppStyle.font_size_small;
                color: AppStyle.text_secondary;
                height: 18px;
            }
            ComboBox {
                height: 30px;
                min-width: 0px;
                model: ["Active Brake", "Free Float"];
                current-index: root.mode_config.release_action;
                selected(val) => {
                    if (val == "Active Brake") {
                        root.mode_config.release_action = 0;
                    } else {
                        root.mode_config.release_action = 1;
                    }
                    root.mode_changed();
                }
            }
        }
    }

    if !root.is_half_bridge: Text {
        text: "Parameters";
        font-size: AppStyle.font_size_body;
        color: AppStyle.text_primary;
        font-weight: 600;
        height: 24px;
    }

    if !root.is_half_bridge: Rectangle {
        background: AppStyle.bg_dialog;

        VerticalLayout {
            spacing: 0px;

            if root.mode_config.mode_type == 0: InstantModeParams {
                data: root.mode_config.instant_data;
                confirmed_value: root.confirmed_value;
                confirmed_field: root.confirmed_field;
                spacing: 0px;
                request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals) => {
                    root.request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals);
                }
                changed => {
                    root.mode_config.instant_data = self.data;
                    root.mode_changed();
                }
            }

            if root.mode_config.mode_type == 1: RampedModeParams {
                data: root.mode_config.ramped_data;
                confirmed_value: root.confirmed_value;
                confirmed_field: root.confirmed_field;
                request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals) => {
                    root.request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals);
                }
                changed => {
                    root.mode_config.ramped_data = self.data;
                    root.mode_changed();
                }
            }

            if root.mode_config.mode_type == 2: PulseModeParams {
                data: root.mode_config.pulse_data;
                confirmed_value: root.confirmed_value;
                confirmed_field: root.confirmed_field;
                request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals) => {
                    root.request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals);
                }
                changed => {
                    root.mode_config.pulse_data = self.data;
                    root.mode_changed();
                }
            }

            if root.mode_config.mode_type == 3: ToggleModeParams {
                data: root.mode_config.toggle_data;
                confirmed_value: root.confirmed_value;
                confirmed_field: root.confirmed_field;
                request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals) => {
                    root.request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals);
                }
                changed => {
                    root.mode_config.toggle_data = self.data;
                    root.mode_changed();
                }
            }

            if root.mode_config.mode_type == 4: ADSRModeParams {
                data: root.mode_config.adsr_data;
                confirmed_value: root.confirmed_value;
                confirmed_field: root.confirmed_field;
                request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals) => {
                    root.request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals);
                }
                changed => {
                    root.mode_config.adsr_data = self.data;
                    root.mode_changed();
                }
            }

            if root.mode_config.mode_type == 5: CCControlModeParams {
                data: root.mode_config.cc_data;
                confirmed_value: root.confirmed_value;
                confirmed_field: root.confirmed_field;
                is_assigning_cc <=> root.is_assigning_cc;
                request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals) => {
                    root.request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals);
                }
                assign_cc => {
                    root.assign_cc();
                }
                reset_cc => {
                    root.reset_cc();
                }
                changed => {
                    root.mode_config.cc_data = self.data;
                    root.mode_changed();
                }
            }

            if root.mode_config.mode_type == 6: PitchBendModeParams {
                data: root.mode_config.pitchbend_data;
                confirmed_value: root.confirmed_value;
                confirmed_field: root.confirmed_field;
                request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals) => {
                    root.request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals);
                }
                changed => {
                    root.mode_config.pitchbend_data = self.data;
                    root.mode_changed();
                }
            }
        }
    }

    if root.is_half_bridge: Rectangle {
        vertical-stretch: 1;

        Text {
            text: "Output modes not supported\nin half-bridge mode";
            color: AppStyle.text_disabled;
            font-size: AppStyle.font_size_body;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }
    }
}
