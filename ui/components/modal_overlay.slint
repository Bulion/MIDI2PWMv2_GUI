import { AppStyle } from "../style.slint";

export component ModalOverlay inherits Rectangle {
    callback dismissed();

    z: 400;
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: AppStyle.overlay_backdrop;

    TouchArea {
        clicked => {
            root.dismissed();
        }
    }

    @children
}
