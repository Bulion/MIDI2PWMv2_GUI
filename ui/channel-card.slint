import { LinearGauge } from "linear-gauge.slint";
import { AppStyle } from "style.slint";

component OutputsIndicator inherits HorizontalLayout {
    height: AppStyle.gauge_output_height;
    for i in 4: Rectangle {
        background: (i == 0 || i == 3) ? AppStyle.accent_orange_darker : AppStyle.bg_track;
    }
}

component DutyCycleGauge inherits LinearGauge {
    height: AppStyle.gauge_height;
    min_value: 0.0;
    max_value: 100.0;
    track_color: AppStyle.bg_track;
    fill_color: AppStyle.accent_blue;
}

component DutyCycleText inherits Text {
    color: AppStyle.text_primary;
    font-size: AppStyle.font_size_body;
    horizontal-alignment: center;
}

component TelemetryRow inherits HorizontalLayout {
    in property <string> voltage;
    in property <string> current;
    spacing: AppStyle.spacing_xs;

    VerticalLayout {
        Text {
            text: voltage;
            color: AppStyle.text_primary;
            font-size: AppStyle.font_size_body_lg;
            horizontal-alignment: center;
        }

        Text {
            text: "V";
            color: AppStyle.text_primary;
            font-size: AppStyle.font_size_tiny;
            horizontal-alignment: center;
        }
    }

    VerticalLayout {
        Text {
            text: current;
            color: AppStyle.text_primary;
            font-size: AppStyle.font_size_body_lg;
            horizontal-alignment: center;
        }

        Text {
            text: "mA";
            color: AppStyle.text_primary;
            font-size: AppStyle.font_size_tiny;
            horizontal-alignment: center;
        }
    }
}

component NoteDisplay inherits VerticalLayout {
    in property <string> note: "";
    in property <int> note_number: 255;
    in property <bool> is_cc_mode: false;
    in property <int> cc_number: 0;

    spacing: 0px;

    Text {
        text: root.note;
        color: AppStyle.text_tertiary;
        font-size: AppStyle.font_size_calculator;
        horizontal-alignment: center;
    }

    Text {
        text: root.note_number <= 127
            ? (root.is_cc_mode
                ? ("N: " + root.note_number + " CC: " + root.cc_number)
                : ("N: " + root.note_number))
            : "";
        color: AppStyle.text_primary;
        font-size: AppStyle.font_size_body_lg;
        horizontal-alignment: center;
    }
}

export component ChannelCard {
    in property <string> note: "E#";
    in property <int> note_number: 255;
    in property <float> voltage: 20.0;
    in property <float> current: 2300.0;
    in property <float> duty_cycle: 50.0;
    in property <bool> is_active: false;
    in property <bool> has_fault: false;
    in property <bool> invert: false;
    in property <int> mode_type: 0;
    in property <int> polarity: 0;
    in property <int> cc_number: 0;
    callback clicked;

    private property <bool> is_cc_mode: root.mode_type == 5;
    private property <bool> is_reverse: root.invert ? root.polarity != 1 : root.polarity == 1;
    private property <float> effective_duty_cycle: (root.is_active || root.is_cc_mode) ? root.duty_cycle : 0.0;
    private property <string> voltage_formatted: Math.round(root.voltage * 10) / 10;
    private property <string> current_formatted: Math.round(root.current);
    private property <string> duty_cycle_formatted: Math.round(root.effective_duty_cycle * 10) / 10;

    width: AppStyle.card_width;
    height: AppStyle.card_height;

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.clicked();
        }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;

        Rectangle {
            OutputsIndicator {
                y: root.invert ? 0px : root.height - self.height;
            }

            Image {
                width: parent.width;
                height: parent.height;
                source: root.has_fault
                    ? (root.invert ? @image-url("assets/channel-card-inverted-error.png") : @image-url("assets/channel-card-error.png"))
                    : root.is_active
                        ? (root.invert ? @image-url("assets/channel-card-inverted-active.png") : @image-url("assets/channel-card-active.png"))
                        : (root.invert ? @image-url("assets/channel-card-inverted.png") : @image-url("assets/channel-card.png"));
            }
        }

        VerticalLayout {
            padding: AppStyle.spacing_xs;
            padding-top: !root.invert ? AppStyle.spacing_xs : 35px;
            padding-bottom: root.invert ? AppStyle.spacing_xs : 35px;
            spacing: AppStyle.spacing_xs;

            if root.invert: DutyCycleGauge {
                value: root.effective_duty_cycle;
                reverse: root.is_reverse;
            }
            if root.invert: DutyCycleText {
                text: root.duty_cycle_formatted + " %";
            }
            if root.invert: TelemetryRow {
                voltage: root.voltage_formatted;
                current: root.current_formatted;
            }

            NoteDisplay {
                note: root.note;
                note_number: root.note_number;
                is_cc_mode: root.is_cc_mode;
                cc_number: root.cc_number;
            }

            if !root.invert: TelemetryRow {
                voltage: root.voltage_formatted;
                current: root.current_formatted;
            }
            if !root.invert: DutyCycleText {
                text: root.duty_cycle_formatted + " %";
            }
            if !root.invert: DutyCycleGauge {
                value: root.effective_duty_cycle;
                reverse: root.is_reverse;
            }
        }
    }
}
