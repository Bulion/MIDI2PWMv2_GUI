import {
    VerticalBox,
    HorizontalBox,
    ComboBox,
    Button,
    AboutSlint,
} from "std-widgets.slint";
import { ChannelCard } from "channel-card.slint";
import { ChannelConfigPopup, ModeConfig } from "channel-config-popup.slint";
import { NumericInputPopup } from "numeric-input-popup.slint";
import { ChannelData } from "channel-data.slint";
import { DefaultModels } from "default-models-data.slint";
import { AppStyle } from "style.slint";

export { ChannelData }

component ConnectionScreen inherits Rectangle {
    in property <[string]> available_ports: [];
    in-out property <int> selected_index: -1;
    in-out property <string> status_text: "";

    callback refresh();
    callback connect(string);

    width: 100%;
    height: 100%;
    background: AppStyle.bg_primary;

    VerticalBox {
        width: 60%;
        height: 50%;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        spacing: AppStyle.spacing_xl;

        Text {
            text: "Select MIDI Connection";
            font-size: AppStyle.font_size_heading_sm;
            color: AppStyle.text_primary;
        }

        ComboBox {
            model: root.available_ports;
            current_index <=> root.selected_index;
            enabled: root.available_ports.length > 0;
        }

        HorizontalBox {
            spacing: AppStyle.spacing_lg;

            Button {
                text: "Refresh";
                clicked => {
                    root.refresh();
                }
            }

            Button {
                text: "Connect";
                enabled: root.selected_index >= 0 && root.selected_index < root.available_ports.length;
                clicked => {
                    if (root.selected_index >= 0 && root.selected_index < root.available_ports.length) {
                        root.connect(root.available_ports[root.selected_index]);
                    }
                }
            }
        }

        Text {
            text: root.status_text;
            color: AppStyle.status_error;
            visible: root.status_text != "";
        }
    }
}

export component AppWindow inherits Window {
    preferred-width: AppStyle.window_preferred_width;
    preferred-height: AppStyle.window_preferred_height;
    min-width: AppStyle.window_preferred_width;
    min-height: AppStyle.window_preferred_height;
    max-width: AppStyle.window_preferred_width;
    max-height: AppStyle.window_preferred_height;
    background: AppStyle.bg_primary;

    in-out property <string> midi_message: "No midi message received yet";
    in-out property <bool> show_connection_screen: false;
    in-out property <bool> waiting_for_device_data: false;
    in-out property <[string]> available_ports: [];
    in-out property <int> selected_port_index: -1;
    in-out property <string> connection_status: "";

    in-out property <[ChannelData]> channel_model: DefaultModels.channels;

    private property <bool> show_popup: false;
    private property <int> current_channel_index: 0;

    in-out property <string> temp_note: "";
    private property <string> temp_fault: "";
    in-out property <bool> temp_is_assigning: false;
    in-out property <bool> temp_is_assigning_cc: false;
    in-out property <bool> temp_popup_dirty: false;

    in-out property <ModeConfig> temp_mode_config: {
        mode_type: 0,
        instant_data: { on_level: 255, velocity_sensitive: true },
        ramped_data: { on_level: 255, velocity_sensitive: true, attack_time_ms: 100, release_time_ms: 100 },
    };

    in property <length> card_width: AppStyle.card_width;
    in property <length> card_height: AppStyle.card_height;

    private property <bool> show_numeric_input: false;
    private property <int> numeric_input_min: 0;
    private property <int> numeric_input_max: 255;
    private property <int> numeric_input_value: 0;
    private property <string> numeric_input_label: "";
    private property <string> numeric_input_suffix: "";
    private property <[string]> numeric_input_quick_buttons: [];
    private property <int> numeric_input_max_decimals: 0;
    private property <string> active_field: "";

    private property <int> confirmed_value: -1;
    private property <string> confirmed_field: "";

    callback refresh_ports();
    callback connect_port(string);
    callback save_channel_config(int, string, ModeConfig);
    callback assign_note_clicked(int);
    callback reset_note_clicked(int);
    callback note_assigned_from_backend(string);
    callback assign_cc_clicked();
    callback reset_cc_clicked();
    callback cc_assigned_from_backend(int);
    callback popup_closed();

    ConnectionScreen {
        visible: root.show_connection_screen;
        available_ports: root.available_ports;
        selected_index <=> root.selected_port_index;
        status_text <=> root.connection_status;
        refresh => {
            root.refresh_ports();
        }
        connect(port) => {
            root.connect_port(port);
        }
    }

    Rectangle {
        visible: root.waiting_for_device_data && !root.show_connection_screen;
        z: 200;
        width: parent.width;
        height: parent.height;
        background: AppStyle.bg_primary;

        VerticalBox {
            alignment: center;

            Text {
                text: "Connecting to device...";
                font-size: AppStyle.font_size_heading;
                color: AppStyle.text_primary;
                horizontal-alignment: center;
            }

            Text {
                text: "Waiting for telemetry data";
                font-size: AppStyle.font_size_body_lg;
                color: AppStyle.text_secondary;
                horizontal-alignment: center;
            }
        }
    }

    Rectangle {
        visible: !root.show_connection_screen && !root.waiting_for_device_data;
        z: 100;
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #0000;

        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: root.midi_message;
            color: AppStyle.text_primary;
            font-size: AppStyle.font_size_heading;
        }

        for i in 16: ChannelCard {
            private property <int> row_count: i < 8 ? 1 : 0;
            private property <int> col_count: row_count == 1 ? Math.mod(i, 8) : 7 - Math.mod(i, 8);

            clicked => {
                root.show_popup = true;
                root.current_channel_index = i;
                root.temp_note = root.channel_model[i].note;
                root.temp_fault = root.channel_model[i].fault;
                root.temp_is_assigning = false;
                root.temp_popup_dirty = false;
                root.temp_mode_config = {
                    mode_type: root.channel_model[i].mode_type,
                    instant_data: root.channel_model[i].instant_data,
                    ramped_data: root.channel_model[i].ramped_data,
                };
            }

            x: col_count * card_width;
            y: row_count == 1 ? parent.height - card_height : 0px;
            width: card_width;
            height: card_height;
            note: root.channel_model.length > i ? root.channel_model[i].note : "";
            voltage: root.channel_model.length > i ? root.channel_model[i].voltage : 0.0;
            current: root.channel_model.length > i ? root.channel_model[i].current : 0.0;
            duty_cycle: root.channel_model.length > i ? root.channel_model[i].duty_cycle : 0.0;
            is_active: root.channel_model.length > i ? root.channel_model[i].is_active : false;
            invert: row_count == 0;
        }

        Rectangle {
            visible: show_popup;
            z: 101;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: AppStyle.overlay_backdrop;

            TouchArea {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                clicked => {
                    if (!root.temp_popup_dirty) {
                        show_popup = false;
                        root.popup_closed();
                    }
                }
            }

            ChannelConfigPopup {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                channel_index: root.current_channel_index;
                note <=> root.temp_note;
                fault: root.temp_fault;
                is_dirty <=> root.temp_popup_dirty;
                is_assigning_note <=> root.temp_is_assigning;

                mode_config <=> root.temp_mode_config;

                confirmed_value: root.confirmed_value;
                confirmed_field: root.confirmed_field;
                is_assigning_cc <=> root.temp_is_assigning_cc;

                request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals) => {
                    root.confirmed_value = -1;
                    root.confirmed_field = "";
                    root.active_field = field;
                    root.numeric_input_min = min;
                    root.numeric_input_max = max;
                    root.numeric_input_value = val;
                    root.numeric_input_label = label;
                    root.numeric_input_suffix = suffix;
                    root.numeric_input_quick_buttons = buttons;
                    root.numeric_input_max_decimals = max_decimals;
                    root.show_numeric_input = true;
                }

                assign_note => {
                    root.assign_note_clicked(root.current_channel_index);
                }

                reset_note => {
                    root.temp_note = "";
                    root.reset_note_clicked(root.current_channel_index);
                }

                assign_cc => {
                    root.assign_cc_clicked();
                }

                reset_cc => {
                    root.reset_cc_clicked();
                }

                reset_fault => {
                    root.temp_fault = "";
                }

                save => {
                    root.save_channel_config(
                        root.current_channel_index,
                        root.temp_note,
                        root.temp_mode_config);
                    root.temp_popup_dirty = false;
                }

                close => {
                    show_popup = false;
                    root.popup_closed();
                }
            }
        }
    }

    Rectangle {
        visible: root.show_numeric_input;
        z: 400;
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: AppStyle.overlay_backdrop;

        TouchArea {
            clicked => {
                root.show_numeric_input = false;
            }
        }

        NumericInputPopup {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            min_value: root.numeric_input_min;
            max_value: root.numeric_input_max;
            current_value: root.numeric_input_value;
            label: root.numeric_input_label;
            suffix: root.numeric_input_suffix;
            quick_buttons: root.numeric_input_quick_buttons;
            max_decimals: root.numeric_input_max_decimals;

            confirmed(new_value) => {
                root.confirmed_value = new_value;
                root.confirmed_field = root.active_field;
                root.show_numeric_input = false;
                root.temp_popup_dirty = true;
            }

            canceled => {
                root.show_numeric_input = false;
            }
        }
    }
}
