import { Button } from "std-widgets.slint";
import { AppStyle } from "style.slint";

export component NoteConfigSection inherits VerticalLayout {
    in-out property <string> note: "";
    in-out property <bool> is_assigning_note: false;

    callback assign_note;
    callback reset_note;
    callback note_changed;

    alignment: LayoutAlignment.start;
    spacing: AppStyle.spacing_lg;

    Text {
        text: "Note Configuration";
        font-size: AppStyle.font_size_body;
        color: AppStyle.text_primary;
        font-weight: 600;
        height: 24px;
    }

    Rectangle {
        height: AppStyle.input_height_sm;
        background: root.is_assigning_note ? AppStyle.accent_green_dark : transparent;
        border-radius: AppStyle.radius_sm;
        border-width: root.is_assigning_note ? AppStyle.border_width_normal : 0px;
        border-color: AppStyle.accent_green;

        Text {
            text: root.is_assigning_note ? "Waiting for MIDI..." : ("Note: " + root.note);
            color: root.is_assigning_note ? AppStyle.accent_green : AppStyle.text_secondary;
            font-size: AppStyle.font_size_body_lg;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    HorizontalLayout {
        spacing: AppStyle.spacing_md;

        Button {
            text: "Assign";
            enabled: !root.is_assigning_note;
            clicked => {
                root.assign_note();
            }
        }

        Button {
            text: "Reset";
            enabled: !root.is_assigning_note;
            clicked => {
                root.reset_note();
                root.note_changed();
            }
        }
    }
}
