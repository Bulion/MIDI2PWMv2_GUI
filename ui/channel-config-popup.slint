import { Button, SpinBox, Slider, ComboBox, CheckBox } from "std-widgets.slint";
import { InstantModeParams, InstantModeData } from "mode-params/instant-mode-params.slint";
import { RampedModeParams, RampedModeData } from "mode-params/ramped-mode-params.slint";

export struct ModeConfig {
    mode_type: int,
    instant_data: InstantModeData,
    ramped_data: RampedModeData,
}

component ConfirmDialog inherits Rectangle {
    callback save_and_close;
    callback discard_and_close;
    callback cancel;

    width: 420px;
    height: 180px;
    background: #2a2a2a;
    border-radius: 8px;
    border-width: 2px;
    border-color: #ff9933;

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        Text {
            text: "Unsaved Changes";
            font-size: 18px;
            color: #fff;
            horizontal-alignment: center;
        }

        Text {
            text: "You have unsaved changes. What would you like to do?";
            font-size: 14px;
            color: #ccc;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 10px;
            padding-top: 10px;

            Button {
                text: "Save";
                clicked => {
                    root.save_and_close();
                }
            }

            Button {
                text: "Discard";
                clicked => {
                    root.discard_and_close();
                }
            }

            Button {
                text: "Cancel";
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}

export component ChannelConfigPopup inherits Rectangle {
    in-out property <int> channel_index: 0;
    in-out property <string> note: "";
    in-out property <string> fault: "";
    in-out property <bool> is_dirty: false;
    in-out property <bool> is_assigning_note: false;

    in-out property <ModeConfig> mode_config: {
        mode_type: 0,
        instant_data: { on_level: 255, velocity_sensitive: true },
        ramped_data: { on_level: 255, velocity_sensitive: true, attack_time_ms: 100, release_time_ms: 100 },
    };

    callback assign_note;
    callback reset_note;
    callback reset_fault;
    callback save;
    callback close;

    private property <bool> show_confirm_dialog: false;

    width: 640px;
    height: 400px;
    background: #232323;
    border-radius: 12px;
    border-width: 2px;
    border-color: #aaa;

    TouchArea {
        width: parent.width;
        height: parent.height;
    }
    
    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 12px;
        alignment: LayoutAlignment.stretch;
        padding-bottom: 12px;
        spacing: 12px;


        HorizontalLayout {
            Button {
                text: "Save";
                width: 70px;
                height: 36px;
                enabled: root.is_dirty;
            
                clicked => {
                    root.save();
                    root.is_dirty = false;
                }
            }
            Text {
                text: "Configure Channel";
                vertical-alignment: TextVerticalAlignment.center;
                font-size: 18px;
                horizontal-alignment: TextHorizontalAlignment.center;
                color: #ffffff;
            }
            Button {
                text: "X";
                width: 36px;
                height: 36px;
            
                clicked => {
                    if (root.is_dirty) {
                        root.show_confirm_dialog = true;
                    } else {
                        root.is_assigning_note = false;
                        root.close();
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: LayoutAlignment.stretch;
            spacing: 12px;

            VerticalLayout {
                alignment: LayoutAlignment.start;
                spacing: 12px;
                width: 50%;

            Text {
                text: "Note Configuration";
                font-size: 14px;
                color: #fff;
                font-weight: 600;
                height: 24px;
            }

            Rectangle {
                height: 36px;
                background: root.is_assigning_note ? #445533 : transparent;
                border-radius: 4px;
                border-width: root.is_assigning_note ? 2px : 0px;
                border-color: #88cc44;

                Text {
                    text: root.is_assigning_note ? "Waiting for MIDI..." : ("Note: " + root.note);
                    color: root.is_assigning_note ? #88cc44 : #eee;
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "Assign";
                    enabled: !root.is_assigning_note;
                    clicked => {
                        root.assign_note();
                        root.is_assigning_note = true;
                    }
                }

                Button {
                    text: "Reset";
                    enabled: !root.is_assigning_note;
                    clicked => {
                        root.reset_note();
                        root.is_dirty = true;
                    }
                }
            }

            Rectangle {
                height: 8px;
            }

            Text {
                text: "Fault Status";
                font-size: 14px;
                color: #fff;
                font-weight: 600;
            }

            Text {
                text: root.fault == "" ? "None" : root.fault;
                color: root.fault == "" ? #0f0 : #f66;
                font-size: 13px;
            }

            Button {
                text: "Reset Fault";
                enabled: root.fault != "";
                clicked => {
                    root.reset_fault();
                }
                width: 100px;
            }
        }

        Rectangle {
            width: 1px;
            background: #444;
        }

        VerticalLayout {
            alignment: LayoutAlignment.start;
            spacing: 8px;

            Text {
                text: "Output Mode";
                font-size: 14px;
                color: #fff;
                font-weight: 600;
                height: 24px;
            }

            ComboBox {
                height: 30px;
                model: ["Instant On/Off", "Ramped On/Off", "Timed Pulse", "Toggle", "ADSR Envelope", "CC Control", "Pitch Bend"];
                current-index: root.mode_config.mode_type;
                selected(selected_value) => {
                    if (selected_value == "Instant On/Off") {
                        root.mode_config.mode_type = 0;
                    } else if (selected_value == "Ramped On/Off") {
                        root.mode_config.mode_type = 1;
                    } else if (selected_value == "Timed Pulse") {
                        root.mode_config.mode_type = 2;
                    } else if (selected_value == "Toggle") {
                        root.mode_config.mode_type = 3;
                    } else if (selected_value == "ADSR Envelope") {
                        root.mode_config.mode_type = 4;
                    } else if (selected_value == "CC Control") {
                        root.mode_config.mode_type = 5;
                    } else if (selected_value == "Pitch Bend") {
                        root.mode_config.mode_type = 6;
                    }
                    root.is_dirty = true;
                }
            }

            Text {
                text: "Parameters";
                font-size: 14px;
                color: #fff;
                font-weight: 600;
                height: 24px;
            }

            if root.mode_config.mode_type == 0: InstantModeParams {
                data: root.mode_config.instant_data;
                spacing: 0px;
                changed => {
                    root.mode_config.instant_data = self.data;
                    root.is_dirty = true;
                }
            }

            if root.mode_config.mode_type == 1: RampedModeParams {
                data: root.mode_config.ramped_data;
                changed => {
                    root.mode_config.ramped_data = self.data;
                    root.is_dirty = true;
                }
            }
        }
        }
    }

    Rectangle {
        visible: root.show_confirm_dialog;
        z: 200;
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #000a;

        ConfirmDialog {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            save_and_close => {
                root.show_confirm_dialog = false;
                root.save();
                root.is_dirty = false;
                root.is_assigning_note = false;
                root.close();
            }

            discard_and_close => {
                root.show_confirm_dialog = false;
                root.is_dirty = false;
                root.is_assigning_note = false;
                root.close();
            }

            cancel => {
                root.show_confirm_dialog = false;
            }
        }
    }
}
