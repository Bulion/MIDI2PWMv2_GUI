import { Button } from "std-widgets.slint";
import { AppStyle } from "style.slint";

export component NumericInputPopup inherits Rectangle {
    in property <int> min_value: 0;
    in property <int> max_value: 255;
    in property <int> current_value: 0;
    in property <string> label: "Value";
    in property <string> suffix: "";
    in property <[string]> quick_buttons: [];
    in property <bool> is_float: false;

    callback confirmed(int);
    callback canceled();

    private property <string> input_text: "";
    private property <bool> first_digit_entry: true;
    private property <int> parsed_value: root.is_float ? Math.round(input_text.to-float() * 10.0) : input_text.to-float();
    private property <bool> is_valid: parsed_value >= min_value && parsed_value <= max_value;

    changed current_value => {
        root.input_text = root.is_float ? (current_value / 10.0) : (current_value + "");
        first_digit_entry = true;
    }

    width: AppStyle.popup_numeric_width;
    height: AppStyle.popup_numeric_height;
    background: AppStyle.bg_popup;
    border-radius: AppStyle.radius_md;
    border-width: AppStyle.border_width_normal;
    border-color: AppStyle.accent_orange;

    TouchArea {
        width: parent.width;
        height: parent.height;
    }

    VerticalLayout {
        padding: AppStyle.spacing_xl;
        spacing: AppStyle.spacing_lg;

        HorizontalLayout {
            Text {
                text: root.label + (root.suffix != "" ? " (" + root.suffix + ")" : "");
                font-size: AppStyle.font_size_body_lg;
                color: AppStyle.text_primary;
                font-weight: 600;
                vertical-alignment: center;
            }

            Button {
                text: "X";
                width: AppStyle.input_height_sm;
                height: AppStyle.input_height_sm;
                clicked => {
                    root.canceled();
                }
            }
        }

        Rectangle {
            height: AppStyle.input_height_lg;
            background: AppStyle.bg_primary;
            border-width: AppStyle.border_width_thin;
            border-color: AppStyle.border_default;

            Text {
                text: root.input_text;
                font-size: AppStyle.font_size_heading;
                color: root.is_valid ? AppStyle.text_primary : AppStyle.status_error;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            background: AppStyle.bg_popup;

            VerticalLayout {
                spacing: AppStyle.spacing_md;

                GridLayout {
                    spacing: AppStyle.spacing_sm;
                    Row {
                        Rectangle {
                            background: AppStyle.bg_input;
                            border-width: AppStyle.border_width_thin;
                            border-color: AppStyle.border_default;

                            Text {
                                text: "7";
                                font-size: AppStyle.font_size_calculator;
                                color: AppStyle.text_primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    if (root.first_digit_entry) {
                                    root.input_text = "7";
                                    first_digit_entry = false;
                                } else {
                                    root.input_text += "7";
                                }
                                }
                            }
                        }

                        Rectangle {
                            background: AppStyle.bg_input;
                            border-width: AppStyle.border_width_thin;
                            border-color: AppStyle.border_default;

                            Text {
                                text: "8";
                                font-size: AppStyle.font_size_calculator;
                                color: AppStyle.text_primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    if (root.first_digit_entry) {
                                    root.input_text = "8";
                                    first_digit_entry = false;
                                } else {
                                    root.input_text += "8";
                                }
                                }
                            }
                        }

                        Rectangle {
                            background: AppStyle.bg_input;
                            border-width: AppStyle.border_width_thin;
                            border-color: AppStyle.border_default;

                            Text {
                                text: "9";
                                font-size: AppStyle.font_size_calculator;
                                color: AppStyle.text_primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    if (root.first_digit_entry) {
                                    root.input_text = "9";
                                    first_digit_entry = false;
                                } else {
                                    root.input_text += "9";
                                }
                                }
                            }
                        }

                        Rectangle {
                            col: 3;
                            colspan: 1;
                            background: AppStyle.bg_button;
                            border-width: AppStyle.border_width_thin;
                            border-color: AppStyle.border_default;

                            Text {
                                text: "←";
                                font-size: AppStyle.font_size_calculator;
                                color: AppStyle.text_primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    root.input_text = "";
                                }
                            }
                        }
                    }

                    Row {
                        Rectangle {
                            background: AppStyle.bg_input;
                            border-width: AppStyle.border_width_thin;
                            border-color: AppStyle.border_default;

                            Text {
                                text: "4";
                                font-size: AppStyle.font_size_calculator;
                                color: AppStyle.text_primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    if (root.first_digit_entry) {
                                    root.input_text = "4";
                                    first_digit_entry = false;
                                } else {
                                    root.input_text += "4";
                                }
                                }
                            }
                        }

                        Rectangle {
                            background: AppStyle.bg_input;
                            border-width: AppStyle.border_width_thin;
                            border-color: AppStyle.border_default;

                            Text {
                                text: "5";
                                font-size: AppStyle.font_size_calculator;
                                color: AppStyle.text_primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    if (root.first_digit_entry) {
                                    root.input_text = "5";
                                    first_digit_entry = false;
                                } else {
                                    root.input_text += "5";
                                }
                                }
                            }
                        }

                        Rectangle {
                            background: AppStyle.bg_input;
                            border-width: AppStyle.border_width_thin;
                            border-color: AppStyle.border_default;

                            Text {
                                text: "6";
                                font-size: AppStyle.font_size_calculator;
                                color: AppStyle.text_primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    if (root.first_digit_entry) {
                                    root.input_text = "6";
                                    first_digit_entry = false;
                                } else {
                                    root.input_text += "6";
                                }
                                }
                            }
                        }
                    }

                    Row {
                        Rectangle {
                            background: AppStyle.bg_input;
                            border-width: AppStyle.border_width_thin;
                            border-color: AppStyle.border_default;

                            Text {
                                text: "1";
                                font-size: AppStyle.font_size_calculator;
                                color: AppStyle.text_primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    if (root.first_digit_entry) {
                                    root.input_text = "1";
                                    first_digit_entry = false;
                                } else {
                                    root.input_text += "1";
                                }
                                }
                            }
                        }

                        Rectangle {
                            background: AppStyle.bg_input;
                            border-width: AppStyle.border_width_thin;
                            border-color: AppStyle.border_default;

                            Text {
                                text: "2";
                                font-size: AppStyle.font_size_calculator;
                                color: AppStyle.text_primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    if (root.first_digit_entry) {
                                    root.input_text = "2";
                                    first_digit_entry = false;
                                } else {
                                    root.input_text += "2";
                                }
                                }
                            }
                        }

                        Rectangle {
                            background: AppStyle.bg_input;
                            border-width: AppStyle.border_width_thin;
                            border-color: AppStyle.border_default;

                            Text {
                                text: "3";
                                font-size: AppStyle.font_size_calculator;
                                color: AppStyle.text_primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    if (root.first_digit_entry) {
                                    root.input_text = "3";
                                    first_digit_entry = false;
                                } else {
                                    root.input_text += "3";
                                }
                                }
                            }
                        }
                    }

                    Row {
                        Rectangle {
                            background: AppStyle.bg_input;
                            border-width: AppStyle.border_width_thin;
                            border-color: AppStyle.border_default;

                            Text {
                                text: "0";
                                font-size: AppStyle.font_size_calculator;
                                color: AppStyle.text_primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    if (root.first_digit_entry) {
                                    root.input_text = "0";
                                    first_digit_entry = false;
                                } else {
                                    root.input_text += "0";
                                }
                                }
                            }
                        }

                        Rectangle {
                            background: AppStyle.bg_input;
                            border-width: AppStyle.border_width_thin;
                            border-color: AppStyle.border_default;
                            visible: root.is_float;

                            Text {
                                text: ".";
                                font-size: AppStyle.font_size_calculator;
                                color: AppStyle.text_primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                enabled: root.is_float;
                                clicked => {
                                    if (root.first_digit_entry) {
                                        root.input_text = "0.";
                                        first_digit_entry = false;
                                    } else {
                                        root.input_text += ".";
                                    }
                                }
                            }
                        }

                        Rectangle {
                            col: 2;
                            background: AppStyle.bg_button;
                            border-width: AppStyle.border_width_thin;
                            border-color: AppStyle.border_default;

                            Text {
                                text: "C";
                                font-size: 20px;
                                color: #f66;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    root.input_text = "";
                                }
                            }
                        }
                    }
                }

                if root.quick_buttons.length > 0: HorizontalLayout {
                    spacing: AppStyle.spacing_sm;

                    for button-text[index] in root.quick_buttons: Rectangle {
                        background: AppStyle.accent_orange;
                        border-width: AppStyle.border_width_thin;
                        border-color: AppStyle.accent_orange_dark;

                        Text {
                            text: root.is_float ? (button-text.to-float() / 10.0) : button-text;
                            font-size: AppStyle.font_size_body;
                            color: AppStyle.text_primary;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => {
                                root.input_text = root.is_float ? (button-text.to-float() / 10.0) : button-text;
                                first_digit_entry = false;
                            }
                        }
                    }
                }

                Rectangle {
                    height: AppStyle.input_height;
                    background: root.is_valid ? AppStyle.accent_green_confirm : AppStyle.border_default;
                    border-width: AppStyle.border_width_thin;
                    border-color: root.is_valid ? AppStyle.accent_green_confirm_hover : AppStyle.border_default;

                    Text {
                        text: "Confirm";
                        font-size: AppStyle.font_size_body_lg;
                        color: root.is_valid ? AppStyle.text_primary : AppStyle.text_disabled;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        enabled: root.is_valid;
                        clicked => {
                            if (root.is_valid) {
                                root.confirmed(root.parsed_value);
                            }
                        }
                    }
                }
            }
        }
    }
}
