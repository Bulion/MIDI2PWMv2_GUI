import { InstantModeData } from "mode-params/instant-mode-params.slint";
import { RampedModeData } from "mode-params/ramped-mode-params.slint";
import { PulseModeData } from "mode-params/pulse-mode-params.slint";
import { ToggleModeData } from "mode-params/toggle-mode-params.slint";
import { ADSRModeData } from "mode-params/adsr-mode-params.slint";
import { CCControlModeData } from "mode-params/cc-control-mode-params.slint";
import { PitchBendModeData } from "mode-params/pitchbend-mode-params.slint";

export struct ChannelData {
    note: string,
    note_number: int,
    voltage: float,
    current: float,
    duty_cycle: float,
    is_active: bool,
    has_fault: bool,
    mode_type: int,
    polarity: int,
    release_action: int,
    configuration: int,
    note_b: string,
    note_number_b: int,
    is_active_a: bool,
    is_active_b: bool,
    instant_data: InstantModeData,
    ramped_data: RampedModeData,
    pulse_data: PulseModeData,
    toggle_data: ToggleModeData,
    adsr_data: ADSRModeData,
    cc_data: CCControlModeData,
    pitchbend_data: PitchBendModeData,
}
