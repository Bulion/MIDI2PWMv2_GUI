import { Button } from "std-widgets.slint";
import { ConfirmDialog } from "confirm-dialog.slint";
import { NoteConfigSection } from "note-config-section.slint";
import { FaultStatusSection } from "fault-status-section.slint";
import { ModeSelectionSection, ModeConfig } from "mode-selection-section.slint";

export { ModeConfig }

export component ChannelConfigPopup inherits Rectangle {
    in-out property <int> channel_index: 0;
    in-out property <string> note: "";
    in-out property <string> fault: "";
    in-out property <bool> is_dirty: false;
    in-out property <bool> is_assigning_note: false;
    in-out property <bool> is_assigning_cc: false;

    in property <int> confirmed_value: -1;
    in property <string> confirmed_field: "";

    in-out property <ModeConfig> mode_config: {
        mode_type: 0,
        instant_data: { on_level: 255, velocity_sensitive: true },
        ramped_data: { on_level: 255, velocity_sensitive: true, attack_time_ms: 100, release_time_ms: 100 },
        pulse_data: {
            on_level: 255,
            velocity_sensitive: true,
            attack_time_ms: 10,
            hold_time_ms: 100,
            release_time_ms: 50
        },
        toggle_data: { on_level: 255, velocity_sensitive: false, debounce_delay_ms: 50 },
        adsr_data: {
            attack_level: 255,
            sustain_level: 200,
            velocity_sensitive: true,
            attack_time_ms: 50,
            decay_time_ms: 100,
            release_time_ms: 200
        },
        cc_data: { cc_number: 1, center_value: 64, left_max_pwm: 255, right_max_pwm: 255, deadband_range: 2 },
        pitchbend_data: { base_level: 128, bend_range: 64, unipolar: false, velocity_sensitive: true },
    };

    callback assign_note;
    callback reset_note;
    callback reset_fault;
    callback assign_cc;
    callback reset_cc;
    callback save;
    callback close;
    callback request_numeric_input(int, int, int, string, string, [string], string, bool);

    private property <bool> show_confirm_dialog: false;

    width: 640px;
    height: 400px;
    background: #232323;
    border-radius: 12px;
    border-width: 2px;
    border-color: #aaa;

    TouchArea {
        width: parent.width;
        height: parent.height;
    }

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 12px;
        alignment: LayoutAlignment.stretch;
        padding-bottom: 12px;
        spacing: 12px;

        HorizontalLayout {
            Button {
                text: "Save";
                width: 70px;
                height: 36px;
                enabled: root.is_dirty;

                clicked => {
                    root.save();
                    root.is_dirty = false;
                }
            }

            Text {
                text: "Configure Channel";
                vertical-alignment: TextVerticalAlignment.center;
                font-size: 18px;
                horizontal-alignment: TextHorizontalAlignment.center;
                color: #ffffff;
            }

            Button {
                text: "X";
                width: 36px;
                height: 36px;

                clicked => {
                    if (root.is_dirty) {
                        root.show_confirm_dialog = true;
                    } else {
                        root.is_assigning_note = false;
                        root.close();
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: LayoutAlignment.stretch;
            spacing: 12px;

            VerticalLayout {
                width: 50%;

                NoteConfigSection {
                    note <=> root.note;
                    is_assigning_note <=> root.is_assigning_note;

                    assign_note => {
                        root.assign_note();
                        root.is_assigning_note = true;
                    }

                    reset_note => {
                        root.reset_note();
                    }

                    note_changed => {
                        root.is_dirty = true;
                    }
                }

                FaultStatusSection {
                    fault: root.fault;

                    reset_fault => {
                        root.reset_fault();
                    }
                }
            }

            Rectangle {
                width: 1px;
                background: #444;
            }

            ModeSelectionSection {
                mode_config <=> root.mode_config;
                confirmed_value: root.confirmed_value;
                confirmed_field: root.confirmed_field;
                is_assigning_cc <=> root.is_assigning_cc;

                request_numeric_input(min, max, val, label, suffix, buttons, field, is_float) => {
                    root.request_numeric_input(min, max, val, label, suffix, buttons, field, is_float);
                }

                assign_cc => {
                    root.assign_cc();
                }

                reset_cc => {
                    root.reset_cc();
                }

                mode-changed => {
                    root.is_dirty = true;
                }
            }
        }
    }

    Rectangle {
        visible: root.show_confirm_dialog;
        z: 200;
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #000a;

        ConfirmDialog {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            save_and_close => {
                root.show_confirm_dialog = false;
                root.save();
                root.is_dirty = false;
                root.is_assigning_note = false;
                root.close();
            }

            discard_and_close => {
                root.show_confirm_dialog = false;
                root.is_dirty = false;
                root.is_assigning_note = false;
                root.close();
            }

            cancel => {
                root.show_confirm_dialog = false;
            }
        }
    }
}
