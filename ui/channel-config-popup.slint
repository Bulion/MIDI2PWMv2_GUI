import { Button, ComboBox } from "std-widgets.slint";
import { ConfirmDialog } from "confirm-dialog.slint";
import { NoteConfigSection } from "note-config-section.slint";
import { NotePickerPopup } from "note-picker-popup.slint";
import { ModeSelectionSection, ModeConfig } from "mode-selection-section.slint";
import { AppStyle } from "style.slint";

export { ModeConfig }

export component ChannelConfigPopup inherits Rectangle {
    in-out property <int> channel_index: 0;
    in-out property <string> note: "";
    in-out property <string> note_b: "";
    in-out property <bool> has_fault: false;
    in-out property <bool> is_dirty: false;
    in-out property <bool> is_assigning_note: false;
    in-out property <bool> is_assigning_note_b: false;
    in-out property <bool> is_assigning_cc: false;
    in-out property <int> configuration: 0;

    private property <bool> is_half_bridge: root.configuration == 1;

    in property <float> confirmed_value: -1;
    in property <string> confirmed_field: "";

    in-out property <ModeConfig> mode_config: {
        mode_type: 0,
        polarity: 0,
        release_action: 0,
        instant_data: { on_level: 255, velocity_sensitive: true },
        ramped_data: { on_level: 255, velocity_sensitive: true, attack_time_ms: 100, release_time_ms: 100 },
        pulse_data: {
            on_level: 255,
            velocity_sensitive: true,
            attack_time_ms: 10,
            hold_time_ms: 100,
            release_time_ms: 50
        },
        toggle_data: { on_level: 255, velocity_sensitive: false, debounce_delay_ms: 50 },
        adsr_data: {
            attack_level: 255,
            sustain_level: 200,
            velocity_sensitive: true,
            attack_time_ms: 50,
            decay_time_ms: 100,
            release_time_ms: 200
        },
        cc_data: { cc_number: 1, center_value: 64, left_max_pwm: 255, right_max_pwm: 255, deadband_range: 2 },
        pitchbend_data: { base_level: 128, bend_range: 64, unipolar: false, velocity_sensitive: true },
    };

    callback assign_note;
    callback reset_note;
    callback manual_note_selected(string);
    callback assign_note_b;
    callback reset_note_b;
    callback manual_note_b_selected(string);
    callback reset_fault;
    callback assign_cc;
    callback reset_cc;
    callback save;
    callback close;
    callback request_numeric_input(float, float, float, string, string, [float], string, int);

    private property <bool> show_confirm_dialog: false;
    private property <bool> show_note_picker: false;
    private property <bool> show_note_picker_b: false;

    width: AppStyle.popup_config_width;
    height: AppStyle.popup_config_height;
    background: AppStyle.bg_dialog;
    border-radius: AppStyle.radius_lg;
    border-width: AppStyle.border_width_normal;
    border-color: AppStyle.text_disabled;

    TouchArea {
        width: parent.width;
        height: parent.height;
    }

    VerticalLayout {
        padding-left: AppStyle.spacing_lg;
        padding-right: AppStyle.spacing_lg;
        padding-top: AppStyle.spacing_lg;
        alignment: LayoutAlignment.stretch;
        padding-bottom: AppStyle.spacing_lg;
        spacing: AppStyle.spacing_lg;

        HorizontalLayout {
            Button {
                text: "Save";
                width: AppStyle.button_width_sm;
                height: AppStyle.button_height;
                enabled: root.is_dirty;

                clicked => {
                    root.save();
                    root.is_dirty = false;
                }
            }

            Text {
                text: "Configure Channel";
                vertical-alignment: TextVerticalAlignment.center;
                font-size: AppStyle.font_size_subheading;
                horizontal-alignment: TextHorizontalAlignment.center;
                color: AppStyle.text_primary;
            }

            Button {
                text: "X";
                width: AppStyle.input_height_sm;
                height: AppStyle.input_height_sm;

                clicked => {
                    if (root.is_dirty) {
                        root.show_confirm_dialog = true;
                    } else {
                        root.is_assigning_note = false;
                        root.is_assigning_note_b = false;
                        root.close();
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: AppStyle.spacing_lg;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: AppStyle.spacing_md;

                Text {
                    text: "Channel Mode";
                    font-size: AppStyle.font_size_body;
                    color: AppStyle.text_primary;
                    font-weight: 600;
                    height: 24px;
                }

                ComboBox {
                    height: 30px;
                    model: ["H-Bridge", "Half-Bridge"];
                    current-index: root.configuration;
                    selected(val) => {
                        if (val == "H-Bridge") {
                            root.configuration = 0;
                        } else {
                            root.configuration = 1;
                        }
                        root.mode_config.configuration = root.configuration;
                        root.is_dirty = true;
                    }
                }

                if !root.is_half_bridge: NoteConfigSection {
                    note <=> root.note;
                    is_assigning_note <=> root.is_assigning_note;

                    assign_note => {
                        root.assign_note();
                        root.is_assigning_note = true;
                    }

                    reset_note => {
                        root.reset_note();
                    }

                    manual_note => {
                        root.show_note_picker = true;
                    }

                    note_changed => {
                        root.is_dirty = true;
                    }
                }

                if root.is_half_bridge: NoteConfigSection {
                    section_label: "Note A";
                    note <=> root.note;
                    is_assigning_note <=> root.is_assigning_note;

                    assign_note => {
                        root.assign_note();
                        root.is_assigning_note = true;
                    }

                    reset_note => {
                        root.reset_note();
                    }

                    manual_note => {
                        root.show_note_picker = true;
                    }

                    note_changed => {
                        root.is_dirty = true;
                    }
                }

                if root.is_half_bridge: NoteConfigSection {
                    section_label: "Note B";
                    note <=> root.note_b;
                    is_assigning_note <=> root.is_assigning_note_b;

                    assign_note => {
                        root.assign_note_b();
                        root.is_assigning_note_b = true;
                    }

                    reset_note => {
                        root.reset_note_b();
                    }

                    manual_note => {
                        root.show_note_picker_b = true;
                    }

                    note_changed => {
                        root.is_dirty = true;
                    }
                }

                Rectangle { vertical-stretch: 1; }

                if root.has_fault: Button {
                    text: "Reset Fault";
                    height: AppStyle.button_height;

                    clicked => {
                        root.reset_fault();
                    }
                }
            }

            Rectangle {
                width: 1px;
                background: AppStyle.border_default;
            }

            ModeSelectionSection {
                horizontal-stretch: 1;
                mode_config <=> root.mode_config;
                confirmed_value: root.confirmed_value;
                confirmed_field: root.confirmed_field;
                is_assigning_cc <=> root.is_assigning_cc;

                request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals) => {
                    root.request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals);
                }

                assign_cc => {
                    root.assign_cc();
                }

                reset_cc => {
                    root.reset_cc();
                }

                mode-changed => {
                    root.is_dirty = true;
                }
            }
        }
    }

    Rectangle {
        visible: root.show_note_picker;
        z: 200;
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: AppStyle.overlay_backdrop;

        NotePickerPopup {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            confirmed(midi_note, note_name) => {
                root.note = note_name;
                root.is_assigning_note = false;
                root.is_dirty = true;
                root.show_note_picker = false;
                root.manual_note_selected(note_name);
            }

            canceled => {
                root.show_note_picker = false;
            }
        }
    }

    Rectangle {
        visible: root.show_note_picker_b;
        z: 200;
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: AppStyle.overlay_backdrop;

        NotePickerPopup {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            confirmed(midi_note, note_name) => {
                root.note_b = note_name;
                root.is_assigning_note_b = false;
                root.is_dirty = true;
                root.show_note_picker_b = false;
                root.manual_note_b_selected(note_name);
            }

            canceled => {
                root.show_note_picker_b = false;
            }
        }
    }

    Rectangle {
        visible: root.show_confirm_dialog;
        z: 200;
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: AppStyle.overlay_backdrop;

        ConfirmDialog {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            save_and_close => {
                root.show_confirm_dialog = false;
                root.save();
                root.is_dirty = false;
                root.is_assigning_note = false;
                root.is_assigning_note_b = false;
                root.close();
            }

            discard_and_close => {
                root.show_confirm_dialog = false;
                root.is_dirty = false;
                root.is_assigning_note = false;
                root.is_assigning_note_b = false;
                root.close();
            }

            cancel => {
                root.show_confirm_dialog = false;
            }
        }
    }
}
