import { CheckBox } from "std-widgets.slint";
import { SliderWithPopup } from "../slider-with-popup.slint";
import { AppStyle } from "../style.slint";

export struct RampedModeData {
    on_level: float,
    velocity_sensitive: bool,
    attack_time_ms: int,
    release_time_ms: int,
}

export component RampedModeParams inherits VerticalLayout {
    in-out property <RampedModeData> data: {
        on_level: 100.0,
        velocity_sensitive: true,
        attack_time_ms: 100,
        release_time_ms: 100,
    };

    in property <float> confirmed_value: -1;
    in property <string> confirmed_field: "";

    in-out property <float> on_level_value: root.data.on_level;
    in-out property <float> attack_time_value: root.data.attack_time_ms;
    in-out property <float> release_time_value: root.data.release_time_ms;

    callback changed();
    callback request_numeric_input(float, float, float, string, string, [float], string, int);

    changed confirmed_field => {
        if (root.confirmed_value >= 0) {
            if (root.confirmed_field == "ramped_on_level") {
                on_level_value = root.confirmed_value;
                root.changed();
            } else if (root.confirmed_field == "ramped_attack") {
                attack_time_value = Math.round(root.confirmed_value);
                root.changed();
            } else if (root.confirmed_field == "ramped_release") {
                release_time_value = Math.round(root.confirmed_value);
                root.changed();
            }
        }
    }

    changed on_level_value => {
        root.data.on_level = on_level_value;
    }

    changed attack_time_value => {
        root.data.attack_time_ms = Math.round(attack_time_value);
    }

    changed release_time_value => {
        root.data.release_time_ms = Math.round(release_time_value);
    }

    spacing: AppStyle.spacing_sm;

    SliderWithPopup {
        label: "On Level";
        minimum: 0;
        maximum: 100.0;
        value <=> root.on_level_value;
        suffix: "%";
        max_decimals: 1;
        quick_buttons: [0, 50.0, 100.0];
        field_name: "ramped_on_level";
        request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals) => {
            root.request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals);
        }
        changed(new_value) => {
            root.changed();
        }
    }

    CheckBox {
        text: "Velocity Sensitive";
        checked: root.data.velocity_sensitive;
        toggled => {
            root.data.velocity_sensitive = self.checked;
            root.changed();
        }
    }

    SliderWithPopup {
        label: "Attack";
        minimum: 0;
        maximum: 1000;
        value <=> root.attack_time_value;
        suffix: "ms";
        quick_buttons: [0, 500, 1000];
        field_name: "ramped_attack";
        request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals) => {
            root.request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals);
        }
        changed(new_value) => {
            root.changed();
        }
    }

    SliderWithPopup {
        label: "Release";
        minimum: 0;
        maximum: 1000;
        value <=> root.release_time_value;
        suffix: "ms";
        quick_buttons: [0, 500, 1000];
        field_name: "ramped_release";
        request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals) => {
            root.request_numeric_input(min, max, val, label, suffix, buttons, field, max_decimals);
        }
        changed(new_value) => {
            root.changed();
        }
    }
}
