import { Slider } from "std-widgets.slint";
import { AppStyle } from "style.slint";

export component SliderWithPopup inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in-out property <float> value: 0;
    in property <string> label: "";
    in property <string> suffix: "";
    in property <[float]> quick_buttons: [];
    in property <string> field_name: "";
    in property <int> max_decimals: 0;

    callback changed(float);
    callback request_numeric_input(float, float, float, string, string, [float], string, int);
    callback value_updated_externally(float);

    background: transparent;

    changed value => {
        the-slider.value = root.value;
    }

    HorizontalLayout {
        spacing: AppStyle.spacing_md;

        Text {
            text: root.label + (root.suffix != "" ? " (" + root.suffix + "):" : "");
            color: AppStyle.text_tertiary;
            font-size: AppStyle.font_size_small;
            vertical-alignment: center;
            width: 100px;
        }

        the-slider := Slider {
            minimum: root.minimum;
            maximum: root.maximum;
            value: root.value;
            changed(new_value) => {
                root.value = new_value;
                root.changed(new_value);
            }
        }

        Rectangle {
            width: AppStyle.input_width_value_display;
            background: AppStyle.bg_input;
            border-width: AppStyle.border_width_thin;
            border-color: AppStyle.border_default;

            Text {
                text: root.max_decimals > 0
                    ? Math.round(root.value * Math.pow(10.0, root.max_decimals)) / Math.pow(10.0, root.max_decimals)
                    : Math.round(root.value);
                color: AppStyle.text_primary;
                font-size: AppStyle.font_size_small;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => {
                    root.request_numeric_input(
                        root.minimum,
                        root.maximum,
                        root.value,
                        root.label,
                        root.suffix,
                        root.quick_buttons,
                        root.field_name,
                        root.max_decimals);
                }
            }
        }
    }
}
